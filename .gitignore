# This folder is meant to be copied into a repository of its own, so it carries
# its own ignore rules rather than relying on the ones around it.

# The secrets: session key, OAuth client secrets, database password.
# example.env is the template that IS committed; .env never is.
.env

# The SQLite database, created on first run.  It holds real email addresses
# and real ballots -- keep it out of version control.
instance/
*.sqlite*

__pycache__/
*.py[cod]
.venv/
venv/
